{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: server",
            "type": "cppdbg",              // débogueur de l'extension C/C++ (Microsoft)
            "request": "launch",
            "program": "${workspaceFolder}/bin/server",
            "args": ["9000"],              // port d'écoute — adapte selon ton implémentation
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build",      // recompile automatiquement avant de lancer
            "setupCommands": [
                { "description": "Affichage lisible des structures en gdb",
                  "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        },
        {
            "name": "Debug: vsh -list",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/vsh",
            "args": ["-list", "127.0.0.1", "9000"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build",
            "setupCommands": [
                { "description": "Affichage lisible des structures en gdb",
                  "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}